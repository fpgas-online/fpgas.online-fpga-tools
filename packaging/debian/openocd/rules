#!/usr/bin/make -f
# debhelper rules for the fpgas.online OpenOCD build. Rendered from
# packaging/debian/openocd/ by `fpgatools debianize`; @TOOL_VERSION@ is the
# suffix guess-rev.sh (patched) appends to the AC_INIT version, so that
# `openocd -v` names this exact build.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export OPENOCD_LOCAL_VERSION = @TOOL_VERSION@
# rp1_pio_jtag links the shared librp1jtag0, found through rp1jtag.pc.

# --enable-linuxgpiod or --disable-linuxgpiod: the 0.12.0 release cannot be
# built against libgpiod 2.x (trixie, sid); see packaging/linuxgpiod-flag.sh.
# FPGATOOLS_REPO points at the fpgas.online-fpga-tools checkout.
FPGATOOLS_REPO ?= /work
LINUXGPIOD_FLAG := $(shell $(FPGATOOLS_REPO)/packaging/linuxgpiod-flag.sh $(CURDIR))

%:
	dh $@

# bootstrap regenerates configure from configure.ac (which the patch series
# touches). nosubmodule: jimtcl/ was populated by packaging/fetch-jimtcl.sh
# at the commit this OpenOCD records (the distribution jimtcl does not match
# every upstream version: 0.12.0 fails against 0.83), and Debian's libjaylink
# replaces that submodule.
override_dh_autoreconf:
	dh_autoreconf ./bootstrap -- nosubmodule

override_dh_auto_configure:
	dh_auto_configure -- \
		--enable-rp1-pio-jtag \
		--enable-bcm2835gpio \
		$(LINUXGPIOD_FLAG) \
		--enable-sysfsgpio \
		--enable-remote-bitbang \
		--enable-internal-jimtcl \
		--disable-internal-libjaylink \
		--disable-doxygen-html \
		--disable-doxygen-pdf \
		--disable-werror

override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install
	install -D -m 0644 contrib/60-openocd.rules \
		debian/@PACKAGE@/usr/lib/udev/rules.d/60-openocd.rules
	set -e; bin=debian/@PACKAGE@/usr/bin/openocd; \
	$$bin -v 2>&1 | grep -q -- '@TOOL_VERSION@' || { echo "ERROR: -v does not report @TOOL_VERSION@" >&2; exit 1; }; \
	drivers="rp1_pio_jtag bcm2835gpio"; \
	[ "$(LINUXGPIOD_FLAG)" = --enable-linuxgpiod ] && drivers="$$drivers linuxgpiod"; \
	for drv in $$drivers; do \
		if $$bin -c "adapter driver $$drv" -c shutdown 2>&1 | grep -qi invalid; then \
			echo "ERROR: adapter driver $$drv missing" >&2; exit 1; \
		fi; \
	done
