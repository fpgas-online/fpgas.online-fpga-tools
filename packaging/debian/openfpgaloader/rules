#!/usr/bin/make -f
# debhelper rules for the fpgas.online openFPGALoader build. Rendered from
# packaging/debian/openfpgaloader/ by `fpgatools debianize`; @TOOL_VERSION@
# is the string --Version must print.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# The rp1pio cable links librp1jtag0 (found through rp1jtag.pc). The series
# also links libpio when it finds one, for a static librp1jtag; against the
# shared library nothing references it, and --as-needed drops it.
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DENABLE_CABLE_ALL=ON \
		-DENABLE_VENDORS_ALL=ON \
		-DENABLE_LIBGPIOD=ON \
		-DENABLE_UDEV=ON \
		-DENABLE_USB_SCAN=ON \
		-DENABLE_TT_MICROPYTHON=ON \
		-DENABLE_RP1_PIO=ON \
		-DOPENFPGALOADER_VERSION=@TOOL_VERSION@

# Upstream has no test suite that runs without hardware.
override_dh_auto_test:

# The cables the fpgas.online fleet relies on must be present in the
# binary, not silently dropped because a header was missing at configure.
override_dh_auto_install:
	dh_auto_install
	install -D -m 0644 99-openfpgaloader.rules \
		debian/@PACKAGE@/usr/lib/udev/rules.d/99-openfpgaloader.rules
	# Every SPI-flash access on a JTAG-attached FPGA loads a bridge bitstream
	# from /usr/share/openFPGALoader; a package without them cannot read a
	# flash id, let alone --flash-info.
	test -f debian/@PACKAGE@/usr/share/openFPGALoader/spiOverJtag_xc7a100tfgg484.bit.gz \
		|| { echo "ERROR: spiOverJtag bridges not installed" >&2; exit 1; }
	set -e; bin=debian/@PACKAGE@/usr/bin/openFPGALoader; \
	$$bin --list-cables > debian/cables.txt; \
	for cable in rp1pio libgpiod tt_micropython; do \
		grep -qw $$cable debian/cables.txt || { echo "ERROR: cable $$cable missing" >&2; exit 1; }; \
	done; \
	$$bin --Version | grep -q -- '@TOOL_VERSION@' || { echo "ERROR: --Version does not report @TOOL_VERSION@" >&2; exit 1; }
