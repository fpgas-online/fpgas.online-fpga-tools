From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Ansell <me@mith.ro>
Date: Tue, 22 Sep 2026 11:48:00 +0930
Subject: [PATCH 3/4] tcl/board: Kosagi NeTV2 driven from a Raspberry Pi 40-pin
 header

The NeTV2 (Artix-7 XC7A35T or XC7A100T) stacks on a Raspberry Pi and is
programmed over JTAG from the Pi's header: TCK GPIO4, TMS GPIO17,
TDI GPIO27, TDO GPIO22, SRST GPIO24. Which adapter can drive those pins
depends on the Pi generation, so there is one board file per adapter
and one that picks:

  netv2-rpi-bcm2835gpio.cfg  Pi 1-4 / Zero, memory-mapped GPIO (the
                             wiring Alphamax's own scripts use), on top
                             of interface/raspberrypi-native.cfg so the
                             SoC generation and clock calibration are
                             detected rather than typed
  netv2-rpi-rp1pio.cfg       Pi 5 through the RP1 PIO (rp1_pio_jtag)
  netv2-rpi-linuxgpiod.cfg   any Pi through the GPIO character device;
                             NETV2_GPIOCHIP selects the RP1's chip on a
                             Pi 5
  netv2-rpi.cfg              /dev/pio0 -> rp1pio, other Pi 5 ->
                             linuxgpiod, else bcm2835gpio
  netv2-rpi-spiflash.cfg     the configuration flash through a bscan_spi
                             proxy (jtagspi), netv2_spi_init <proxy.bit>

Every file states both pin-order conventions, since OpenOCD's jtag_nums
(TCK TMS TDI TDO) and openFPGALoader's --pins (TDI:TDO:TCK:TMS) describe
the same wires in different orders.
---
 tcl/board/netv2-rpi-bcm2835gpio.cfg | 79 +++++++++++++++++++++++++++++
 tcl/board/netv2-rpi-linuxgpiod.cfg  | 39 ++++++++++++++
 tcl/board/netv2-rpi-rp1pio.cfg      | 25 +++++++++
 tcl/board/netv2-rpi-spiflash.cfg    | 24 +++++++++
 tcl/board/netv2-rpi.cfg             | 29 +++++++++++
 5 files changed, 196 insertions(+)
 create mode 100644 tcl/board/netv2-rpi-bcm2835gpio.cfg
 create mode 100644 tcl/board/netv2-rpi-linuxgpiod.cfg
 create mode 100644 tcl/board/netv2-rpi-rp1pio.cfg
 create mode 100644 tcl/board/netv2-rpi-spiflash.cfg
 create mode 100644 tcl/board/netv2-rpi.cfg

diff --git a/tcl/board/netv2-rpi-bcm2835gpio.cfg b/tcl/board/netv2-rpi-bcm2835gpio.cfg
new file mode 100644
index 0000000..2859689
--- /dev/null
+++ b/tcl/board/netv2-rpi-bcm2835gpio.cfg
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Kosagi NeTV2 (Xilinx Artix-7 XC7A35T or XC7A100T, FGG484) programmed over
+# JTAG from the 40-pin header of a Raspberry Pi 1-4 / Zero, bit-banging the
+# memory-mapped BCM283x GPIO registers (bcm2835gpio). This is the wiring
+# Alphamax's own NeTV2 Raspberry Pi scripts use. A Pi 5 has no such
+# registers: use board/netv2-rpi-rp1pio.cfg there, or board/netv2-rpi.cfg
+# to pick automatically.
+#
+# Wiring (BCM GPIO numbers / header pins):
+#   TCK  GPIO4   pin 7        TDI  GPIO27  pin 13
+#   TMS  GPIO17  pin 11       TDO  GPIO22  pin 15
+#   SRST GPIO24  pin 18 (configured because the driver insists on a reset
+#                        line, but never driven: reset_config none)
+#
+# OpenOCD's jtag_nums take TCK TMS TDI TDO (4 17 27 22); openFPGALoader's
+# --pins take TDI:TDO:TCK:TMS (27:22:4:17) for the same wires.
+#
+# OpenOCD 0.12.0's interface/raspberrypi-native.cfg is fixed to a 700 MHz
+# Pi 1, so the SoC generation and the bit-bang delay calibration are derived
+# here the way later releases do it: the peripheral base (only used when
+# /dev/gpiomem is unavailable and the driver falls back to /dev/mem) from
+# the device tree compatible string, the delay coefficients from the CPU
+# clock.
+
+adapter driver bcm2835gpio
+transport select jtag
+
+proc netv2_read_file { name } {
+	if {[catch {open $name r} fd]} {
+		return ""
+	}
+	set result [read $fd]
+	close $fd
+	return $result
+}
+
+set netv2_compat [netv2_read_file /proc/device-tree/compatible]
+set netv2_clocks_per_loop 4
+if {[string match *bcm2711* $netv2_compat]} {
+	bcm2835gpio peripheral_base 0xFE000000
+	set netv2_speed_offset 52
+} elseif {[string match *bcm2837* $netv2_compat] || [string match *bcm2710* $netv2_compat]} {
+	bcm2835gpio peripheral_base 0x3F000000
+	set netv2_speed_offset 31
+} elseif {[string match *bcm2836* $netv2_compat] || [string match *bcm2709* $netv2_compat]} {
+	bcm2835gpio peripheral_base 0x3F000000
+	set netv2_speed_offset 25
+} elseif {[string match *bcm2835* $netv2_compat] || [string match *bcm2708* $netv2_compat]} {
+	bcm2835gpio peripheral_base 0x20000000
+	set netv2_clocks_per_loop 6
+	set netv2_speed_offset 23
+} elseif {[string match *bcm2712* $netv2_compat]} {
+	echo "Error: a Raspberry Pi 5 drives its header from the RP1, which bcm2835gpio cannot reach."
+	echo "Error: use board/netv2-rpi-rp1pio.cfg or board/netv2-rpi-linuxgpiod.cfg."
+	shutdown
+} else {
+	set netv2_speed_offset 32
+	echo "Warn : Unknown host SoC. Expect a JTAG clock slower than requested."
+}
+
+# Delay loop calibration from the maximum CPU clock (kHz); 2 GHz if unknown.
+set netv2_clock [netv2_read_file /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq]
+if { $netv2_clock < 100000 } {
+	set netv2_clock 2000000
+	echo "Warn : Host CPU clock unknown, assuming $netv2_clock kHz."
+}
+bcm2835gpio speed_coeffs [expr { $netv2_clock / $netv2_clocks_per_loop }] $netv2_speed_offset
+
+adapter gpio tck -chip 0 4
+adapter gpio tms -chip 0 17
+adapter gpio tdi -chip 0 27
+adapter gpio tdo -chip 0 22
+adapter gpio srst -chip 0 24
+
+adapter speed 1000
+reset_config none
+
+source [find cpld/xilinx-xc7.cfg]
diff --git a/tcl/board/netv2-rpi-linuxgpiod.cfg b/tcl/board/netv2-rpi-linuxgpiod.cfg
new file mode 100644
index 0000000..b1eb27c
--- /dev/null
+++ b/tcl/board/netv2-rpi-linuxgpiod.cfg
@@ -0,0 +1,39 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Kosagi NeTV2 (Xilinx Artix-7 XC7A35T or XC7A100T, FGG484) programmed over
+# JTAG from the 40-pin header of any Raspberry Pi through the Linux GPIO
+# character device (linuxgpiod). Slow on a Pi 5 (every edge is a PCIe round
+# trip) but needs no memory-mapped registers and no PIO: the fallback when
+# neither board/netv2-rpi-rp1pio.cfg nor board/netv2-rpi-bcm2835gpio.cfg
+# applies.
+#
+# Wiring (BCM GPIO numbers / header pins):
+#   TCK  GPIO4   pin 7        TDI  GPIO27  pin 13
+#   TMS  GPIO17  pin 11       TDO  GPIO22  pin 15
+#   SRST GPIO24  pin 18 (not driven: reset_config none)
+#
+# OpenOCD's jtag_nums take TCK TMS TDI TDO (4 17 27 22); openFPGALoader's
+# --pins take TDI:TDO:TCK:TMS (27:22:4:17) for the same wires.
+#
+# The header GPIOs are chip 0 on a Pi 1-4. On a Pi 5 they belong to the RP1,
+# which the kernel may register under another number (gpiochip15 on the
+# 6.12 Raspberry Pi kernel; `gpiodetect` lists it as pinctrl-rp1). Set
+# NETV2_GPIOCHIP before sourcing this file to override:
+#
+#   openocd -c 'set NETV2_GPIOCHIP 15' -f board/netv2-rpi-linuxgpiod.cfg
+
+if { ![info exists NETV2_GPIOCHIP] } {
+	set NETV2_GPIOCHIP 0
+}
+
+adapter driver linuxgpiod
+transport select jtag
+adapter gpio tck -chip $NETV2_GPIOCHIP 4
+adapter gpio tms -chip $NETV2_GPIOCHIP 17
+adapter gpio tdi -chip $NETV2_GPIOCHIP 27
+adapter gpio tdo -chip $NETV2_GPIOCHIP 22
+
+adapter speed 1000
+reset_config none
+
+source [find cpld/xilinx-xc7.cfg]
diff --git a/tcl/board/netv2-rpi-rp1pio.cfg b/tcl/board/netv2-rpi-rp1pio.cfg
new file mode 100644
index 0000000..84cab87
--- /dev/null
+++ b/tcl/board/netv2-rpi-rp1pio.cfg
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Kosagi NeTV2 (Xilinx Artix-7 XC7A35T or XC7A100T, FGG484) programmed over
+# JTAG from the 40-pin header of a Raspberry Pi 5, using the RP1 PIO block
+# (rp1_pio_jtag). For a Pi 1-4 use board/netv2-rpi-bcm2835gpio.cfg, or
+# board/netv2-rpi.cfg to pick automatically.
+#
+# Wiring (BCM GPIO numbers / header pins):
+#   TCK  GPIO4   pin 7        TDI  GPIO27  pin 13
+#   TMS  GPIO17  pin 11       TDO  GPIO22  pin 15
+#   SRST GPIO24  pin 18 (not driven: reset_config none)
+#
+# OpenOCD's jtag_nums take TCK TMS TDI TDO (4 17 27 22); openFPGALoader's
+# --pins take TDI:TDO:TCK:TMS (27:22:4:17) for the same wires.
+#
+# Both NeTV2 variants have a single 7-series device on the chain and the
+# xc7 config matches either IDCODE (0x0362D093 / 0x13631093).
+
+source [find interface/raspberrypi-rp1-pio.cfg]
+rp1_pio_jtag jtag_nums 4 17 27 22
+
+adapter speed 1000
+reset_config none
+
+source [find cpld/xilinx-xc7.cfg]
diff --git a/tcl/board/netv2-rpi-spiflash.cfg b/tcl/board/netv2-rpi-spiflash.cfg
new file mode 100644
index 0000000..fee3fc9
--- /dev/null
+++ b/tcl/board/netv2-rpi-spiflash.cfg
@@ -0,0 +1,24 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Kosagi NeTV2 on a Raspberry Pi header: the FPGA's SPI configuration flash,
+# reached through a bscan_spi proxy bitstream loaded into the FPGA (jtagspi).
+#
+# Loading the proxy replaces whatever design is running until the FPGA is
+# reconfigured from flash again (`virtex2 refresh xc7.pld`, or a power cycle).
+# The proxy bitstream must match the FPGA variant: bscan_spi_xc7a35t.bit or
+# bscan_spi_xc7a100t.bit from https://github.com/quartiq/bscan_spi_bitstreams.
+#
+#   openocd -f board/netv2-rpi-spiflash.cfg -c init \
+#       -c "netv2_spi_init bscan_spi_xc7a100t.bit" \
+#       -c "flash info 0" -c shutdown
+#
+#   ... -c "netv2_spi_init bscan_spi_xc7a100t.bit" \
+#       -c "jtagspi_program design.bin 0" -c "virtex2 refresh xc7.pld" -c shutdown
+
+source [find board/netv2-rpi.cfg]
+source [find cpld/jtagspi.cfg]
+
+# Load the proxy bitstream into the FPGA and probe the flash behind it.
+proc netv2_spi_init {proxy_bit} {
+	jtagspi_init xc7.pld $proxy_bit
+}
diff --git a/tcl/board/netv2-rpi.cfg b/tcl/board/netv2-rpi.cfg
new file mode 100644
index 0000000..573fa97
--- /dev/null
+++ b/tcl/board/netv2-rpi.cfg
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+# Kosagi NeTV2 on a Raspberry Pi header: pick the fastest adapter this Pi
+# can offer and load the matching board file.
+#
+#   /dev/pio0 present (Pi 5 with the rp1-pio module)  -> netv2-rpi-rp1pio.cfg
+#   any other Pi 5                                     -> netv2-rpi-linuxgpiod.cfg
+#   Pi 1-4 / Zero                                      -> netv2-rpi-bcm2835gpio.cfg
+#
+# Each of those files documents the wiring; all three use the same pins.
+#
+#   openocd -f board/netv2-rpi.cfg -c init -c "pld load xc7.pld design.bit" -c shutdown
+
+proc netv2_read_file { name } {
+	if {[catch {open $name r} fd]} {
+		return ""
+	}
+	set result [read $fd]
+	close $fd
+	return $result
+}
+
+if {[file exists /dev/pio0]} {
+	source [find board/netv2-rpi-rp1pio.cfg]
+} elseif {[string match "Raspberry Pi 5*" [netv2_read_file /proc/device-tree/model]]} {
+	source [find board/netv2-rpi-linuxgpiod.cfg]
+} else {
+	source [find board/netv2-rpi-bcm2835gpio.cfg]
+}
